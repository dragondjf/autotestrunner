#!/bin/bash
# MyApp - Linux 启动脚本模板
# 复制为 start.sh 并置于绿色版包根目录
# 用法: ./start.sh [--port 3000]

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export NODE_PATH="$SCRIPT_DIR/node_modules"
export PLAYWRIGHT_BROWSERS_PATH="$SCRIPT_DIR/.cache/ms-playwright"
PID_FILE="$SCRIPT_DIR/app.pid"
LOG_FILE="$SCRIPT_DIR/app.log"

if [ -f "$PID_FILE" ]; then
    OLD_PID=$(cat "$PID_FILE")
    if kill -0 "$OLD_PID" 2>/dev/null; then
        echo "[WARN] 应用已在运行 (PID: $OLD_PID)"
        echo "如需重启请先执行 ./stop.sh"
        exit 1
    else
        rm -f "$PID_FILE"
    fi
fi

echo "[INFO] 正在启动应用..."
nohup "$SCRIPT_DIR/node/bin/node" "$SCRIPT_DIR/dist/index.js" "$@" > "$LOG_FILE" 2>&1 &
NEW_PID=$!
echo "$NEW_PID" > "$PID_FILE"
echo "[OK] 应用已启动，PID: $NEW_PID"
echo "[INFO] 日志文件: $LOG_FILE"
echo "[INFO] 停止服务请运行: ./stop.sh"
