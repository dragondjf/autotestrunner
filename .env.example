# ===== web-ui (packages/web-ui) =====
# 服务端口（默认 8080，对应 agent_web_ui 的 PORT）
PORT=8080
# 当前 Python 解释器（run-python 端点用；默认回退 python）
PYTHON=python
# 数据与静态资源目录（默认已指向 node-backend 项目内：data/ 与 static/，可选覆盖）
# WEB_UI_DIR=f:/path/to/data
# STATIC_DIR=f:/path/to/static

# ===== runner (packages/runner)，对应 brick_runner_http/config.py =====
RUNNER_ID=
RUNNER_PORT=8900
RUNNER_HOST=0.0.0.0
RUNNER_VERSION=1.0.0
BACKEND_URL=http://localhost:8000
API_KEY=brickcore-runner-secret
INTERNAL_API_KEY=brickcore-internal-2026
HEADLESS=1
BROWSER_TYPE=chromium
MAX_CONCURRENT=2
HEARTBEAT_INTERVAL=10
DEBUG_POLL_INTERVAL=0.5
RECORD_HEADLESS=0
RECORD_HEARTBEAT_INTERVAL=1
RECORD_VIEWPORT=1366,768
RECORD_PAGE_LOAD_TIMEOUT_MS=60000
# REPORT_DIR 默认 {cwd}/reports
